# /etc/systemd/system/teatr-update.service — подтянуть обновления из GitHub (запускает teatr-update.timer)
# Без Docker команда перезапуска: "/opt/teatr/.venv/bin/pip install -q -r /opt/teatr/requirements.txt && systemctl restart teatr".
[Unit]
Description=Teatr: обновление из GitHub

[Service]
Type=oneshot
ExecStart=/bin/sh /opt/teatr/deploy/autoupdate.sh /opt/teatr "cd /opt/teatr && docker compose up -d --build"
